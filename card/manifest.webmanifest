{
  "name": "LUXTECH | Tudor Neamțu Contact Card",
  "short_name": "LUXTECH Card",
  "description": "Tudor Neamțu’s animated LUXTECH digital business card with QR contact sharing.",
  "id": "/card/",
  "start_url": "./index.html",
